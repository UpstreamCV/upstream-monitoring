# The real api-server scrape token must never be committed; only the
# .example placeholder is. (Pattern is /* rather than the bare directory:
# git cannot re-include a file whose parent directory is excluded.)
prometheus/secrets/*
!prometheus/secrets/api_metrics_token.example

# Same pattern for the alertmanager SMTP password.
alertmanager/secrets/*
!alertmanager/secrets/smtp_password.example
